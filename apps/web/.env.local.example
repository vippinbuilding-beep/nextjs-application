# Supabase project config.
# Get these from: Supabase Dashboard > Project Settings > API
# Copy this file to `.env.local` and fill in the values.
#
# Before running the app, also make sure to:
#   1. Enable "Google" as a provider in Supabase Dashboard > Authentication > Providers
#      (requires a Google OAuth Client ID + Secret from Google Cloud Console)
#   2. Add your callback URL to the Supabase "Redirect URLs" allowlist:
#      http://localhost:3000/auth/callback  (development)
#      https://yourdomain.com/auth/callback (production)
#   3. Run migrations: `supabase db push`
#   4. For video uploads > 50 MB: Supabase Dashboard > Project Settings > Storage
#      → raise "Global file size limit" (requires Pro plan for files > 50 MB)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for Open Graph / share previews (no trailing slash).
# Development: http://localhost:3000
# Production:  https://www.vippin.com.br
NEXT_PUBLIC_SITE_URL=

# Facebook App ID for Open Graph (Sharing Debugger / WhatsApp previews).
# Create an app at https://developers.facebook.com/apps/ and paste the App ID here.
FACEBOOK_APP_ID=

# Support/contact email shown as a "Fale conosco" link (mailto:) on the landing
# page footer. Leave empty to hide the link.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only secrets (NEVER expose these to the client / never prefix with NEXT_PUBLIC).
# Service role key: Supabase Dashboard > Project Settings > API > "service_role".
# Used only in Route Handlers to sign short-lived URLs for the PRIVATE products bucket.
SUPABASE_SERVICE_ROLE_KEY=
# Random secret used to sign short-lived media access tokens.
# Generate one with: openssl rand -base64 32
MEDIA_TOKEN_SECRET=

# AbacatePay
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_API_KEY=

# Dev mode: simulates `/pix/send` locally (AbacatePay sandbox does not support
# outbound transfers). Defaults to true when NODE_ENV=development. Set to
# `false` to call the real API with a production key while running locally.
# ABACATEPAY_DEV_MODE=true

# Cron worker auth (Vercel sends `Authorization: Bearer <CRON_SECRET>` automatically).
# Weekly creator payouts: `/api/cron/weekly-creator-payouts` (Mondays 10:00 BRT).
# Generate one with: openssl rand -base64 32
CRON_SECRET=

# Pagamentos / repasse ao criador
# Taxa da plataforma em cada venda (inteiro, ex.: 10 = 10%). Por venda também
# entra R$ 0,80 fixo; no saque há mais R$ 0,80 de taxa PIX. Padrão: 10
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=10

# Saldo mínimo para saque manual do criador, em centavos (2000 = R$ 20,00)
CREATOR_MIN_WITHDRAWAL_CENTS=2000

# ── Produtos físicos / Melhor Envio ─────────────────────────────────────────
# Conta central da Vippin: todas as etiquetas são pagas pela Melhor Carteira
# desta conta; o remetente impresso é o criador. Token: painel Melhor Envio →
# Integrações → Permissões de acesso (gere um token com escopo de carrinho,
# compra, geração/impressão de etiquetas, rastreio, cancelamento e saldo).
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=true
# Obrigatório pela API: "NomeDoApp (email-de-contato)"
MELHOR_ENVIO_USER_AGENT="Vippin (suporte@vippin.com.br)"
# Desenvolvimento sem credenciais: cotação/etiqueta/rastreio simulados.
# MELHOR_ENVIO_MOCK=true
# Webhook (opcional; o cron já sincroniza): secret do app Melhor Envio usado no
# HMAC do header X-ME-Signature. URL: https://<domínio>/api/webhooks/melhorenvio
MELHOR_ENVIO_WEBHOOK_SECRET=
# Allowlist de serviços (ids da Melhor Envio, separados por vírgula).
# Vazio = só Correios: PAC (1), SEDEX (2), Mini Envios (17).
MELHOR_ENVIO_SERVICE_IDS=
# Rollout: ids de criadores liberados para vender físico. Vazio = todos.
PHYSICAL_PRODUCTS_CREATOR_IDS=
# Declaração de conteúdo (DC-e). "false" desliga para todos (kill switch).
# Regra por perfil: PF → só DC-e; MEI → NF-e ou DC-e; Empresa → só NF-e.
ALLOW_DCE_FOR_SALES=true
# MEI pode usar DC-e além de NF-e (true/false)
ALLOW_DCE_FOR_MEI=true
# Limite mensal de pessoa física (pedidos físicos pagos no mês, fuso de Brasília).
# No limite os produtos físicos do criador ficam indisponíveis até o mês virar.
PF_MONTHLY_ORDER_LIMIT=10
PF_MONTHLY_AMOUNT_LIMIT_CENTS=200000
# % do limite que mostra o aviso "Formalize como MEI"
PF_LIMIT_WARNING_PERCENT=80
# Escrow / prazos (dias)
PREPARE_DEADLINE_DAYS=5
POST_DEADLINE_DAYS=6
ESCROW_AUTORELEASE_DAYS=14
ESCROW_AUTORELEASE_EXTRA_DAYS=7
# Dias após a entrega antes de liberar o repasse (cobre o arrependimento)
ESCROW_DISPUTE_BUFFER_DAYS=7
# Dias após a entrega em que o comprador pode pedir devolução
RETURN_WINDOW_DAYS=7
# Líquido mínimo do criador numa venda com frete grátis, em centavos
MIN_CREATOR_NET_CENTS=200
# Alerta no Discord quando o saldo da Melhor Carteira ficar abaixo disto (centavos)
# e quando um criador travar ao gerar etiqueta (saldo, limite, token, ME fora do ar).
MELHOR_ENVIO_LOW_BALANCE_CENTS=15000
# Webhook do canal de alertas da equipe (Discord → Editar canal → Integrações →
# Webhooks). Secreto: só no servidor. Vazio = alertas desligados.
DISCORD_ALERT_WEBHOOK_URL=
# Webhook de outro canal, só de vendas: uma mensagem a cada venda paga
# (produto, criador e valores; sem dados do comprador). Vazio = desligado.
DISCORD_SALES_WEBHOOK_URL=
# URL do apps/dashboard (links "Resolver em ..." nos alertas de devolução)
DASHBOARD_URL=
# Segredo compartilhado com o apps/dashboard (overrides do escrow em /api/admin/escrow)
ADMIN_API_SECRET=
